# Server-only secrets. Never put these in index.html or src/.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Accounts are created through the registration page; only teacher accounts can upload.
HOST=127.0.0.1
PORT=8765
# Mount this directory on a persistent volume in production.
JOURNEY_DATA_DIR=./storage
# Optional: comma-separated frontend origins when hosting the API separately.
JOURNEY_ALLOWED_ORIGINS=

# For production behind HTTPS, use NODE_ENV=production (Secure cookies).
# For a separate cross-site API, also enable both settings below.
JOURNEY_COOKIE_SECURE=false
JOURNEY_COOKIE_SAMESITE=lax
