# Server-only secrets. Never put these in index.html or src/.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Choose a long, random password for the upload assistant.
JOURNEY_ADMIN_TOKEN=
HOST=127.0.0.1
PORT=8000
# Mount this directory on a persistent volume in production.
JOURNEY_DATA_DIR=./storage
# Optional: comma-separated frontend origins when hosting the API separately.
JOURNEY_ALLOWED_ORIGINS=
